# Copy to .env (local) or set in your hosting dashboard (production).

# Postgres connection string — e.g. a free Neon database:
#   https://neon.tech → new project → connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# The shared editor password. Other users type this in the #/config
# link manager to publish changes. Writes are disabled without it.
ADMIN_PASSWORD="change-me-to-something-long"
